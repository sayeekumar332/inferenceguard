
# ============================================================
# InferenceGuard - Git Ignore Configuration
# ============================================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Python packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
test-results/
junit.xml

# Linters and type checkers
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.dmypy.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE and editor configuration
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# Local logs
*.log
logs/

# Generated inference artifacts
reports/
artifacts/
benchmark-results/
inference-results/
*.prof
*.trace

# Temporary files
tmp/
temp/
.cache/
*.tmp
*.bak

# Jupyter checkpoints
.ipynb_checkpoints/

# Local datasets and model weights
datasets/
models/
checkpoints/
*.safetensors
*.pt
*.pth
*.onnx
*.gguf

# Keep version-controlled examples and test fixtures
!examples/
!tests/fixtures/
